<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B132B"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#090E1E"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#111B36"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#162244"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#1D2D57"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#101A34"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3C68"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#223154"/>

    <!-- Accents & Brands -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#64748B"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#059669"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="#06B6D4"/>
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="#8B5CF6"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#1E293B" Offset="0.5"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#121D3A"/>
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#162244"/>
    <SolidColorBrush x:Key="DataGridRowAltBackgroundBrush" Color="#141E3C"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#2A437C"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#1F305E"/>

    <!-- Drop Shadows -->
    <DropShadowEffect x:Key="CardDropShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.4"/>
    <DropShadowEffect x:Key="GlowPrimaryShadow" BlurRadius="18" ShadowDepth="0" Color="#3B82F6" Opacity="0.5"/>

</ResourceDictionary>