<Window x:Class="AccuBooks_ERP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccuBooks_ERP"
        mc:Ignorable="d"
        Title="AccuBooks ERP - Enterprise Accounting &amp; Inventory Suite"
        Height="840" Width="1320"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/> <!-- Sidebar Navigation -->
            <ColumnDefinition Width="*"/>   <!-- Main Workspace -->
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- LEFT SIDEBAR NAVIGATION                        -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>  <!-- Brand Header -->
                    <RowDefinition Height="*"/>   <!-- Navigation Links -->
                    <RowDefinition Height="Auto"/><!-- User Profile Footer -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5">
                        <Image Source="/Resources/Logo/Logo.png" Margin="6"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="AccuBooks" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI Semibold"/>
                        <TextBlock Text="ENTERPRISE ERP" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,6,10,0">
                        <RadioButton x:Name="navDashboard" Style="{DynamicResource BtnSidebarNav}" Content="📊  Executive Dashboard" IsChecked="True" Checked="NavDashboard_Checked"/>
                        <RadioButton x:Name="navSales" Style="{DynamicResource BtnSidebarNav}" Content="🛒  POS &amp; Sales Invoicing" Checked="NavSales_Checked"/>
                        <RadioButton x:Name="navPurchase" Style="{DynamicResource BtnSidebarNav}" Content="📥  Purchase Bills &amp; Inward" Checked="NavPurchase_Checked"/>
                        <RadioButton x:Name="navCustomers" Style="{DynamicResource BtnSidebarNav}" Content="👥  Customer Directory" Checked="NavCustomers_Checked"/>
                        <RadioButton x:Name="navSuppliers" Style="{DynamicResource BtnSidebarNav}" Content="🏢  Vendor &amp; Suppliers" Checked="NavSuppliers_Checked"/>
                        <RadioButton x:Name="navProducts" Style="{DynamicResource BtnSidebarNav}" Content="📦  Product &amp; Item Catalog" Checked="NavProducts_Checked"/>
                        <RadioButton x:Name="navStock" Style="{DynamicResource BtnSidebarNav}" Content="📋  Inventory &amp; Stock Ledger" Checked="NavStock_Checked"/>
                        <RadioButton x:Name="navJournal" Style="{DynamicResource BtnSidebarNav}" Content="📑  Journal Vouchers (Dr/Cr)" Checked="NavJournal_Checked"/>
                        <RadioButton x:Name="navLedger" Style="{DynamicResource BtnSidebarNav}" Content="📖  Ledger &amp; Trial Balance" Checked="NavLedger_Checked"/>
                        <RadioButton x:Name="navGST" Style="{DynamicResource BtnSidebarNav}" Content="🏛️  GST Compliance Returns" Checked="NavGST_Checked"/>
                        <RadioButton x:Name="navBackup" Style="{DynamicResource BtnSidebarNav}" Content="💾  Backup &amp; Recovery" Checked="NavBackup_Checked"/>
                        <RadioButton x:Name="navSettings" Style="{DynamicResource BtnSidebarNav}" Content="⚙️  Company &amp; Settings" Checked="NavSettings_Checked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- User Profile & Logout -->
                <Border Grid.Row="2" Padding="16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Background="#050811">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblUserName" Text="Administrator" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock x:Name="lblUserRole" Text="SuperAdmin" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="🚪" ToolTip="Logout" Style="{DynamicResource BtnOutline}" Padding="8,4" FontSize="14" Click="BtnLogout_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- RIGHT WORKSPACE                                -->
        <!-- ============================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>   <!-- Top App Bar -->
                <RowDefinition Height="*"/>    <!-- Dynamic View Host -->
                <RowDefinition Height="30"/>   <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Company Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="lblActiveCompany" Text="AccuBooks Enterprise Pvt Ltd" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="#203B82F6" CornerRadius="6" Padding="8,2" Margin="12,0,0,0">
                            <TextBlock x:Name="lblFinancialYear" Text="FY 2026-2027" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Status / Quick Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1510B981" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" DB Engine Online" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="6,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Workspace Content Host -->
            <ContentControl Grid.Row="1" x:Name="MainContentHost"/>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="15,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="AccuBooks ERP v1.0.0 · Local SQLite Encrypted Storage" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="lblSystemClock" Grid.Column="1" Text="System Ready" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
