<Window x:Class="AccuBooks_ERP.GUI.CustomDialogs.SupplierEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplier Details"
        Height="580" Width="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Style="{DynamicResource DialogCard}" Margin="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Close -->
                <RowDefinition Height="*"/>    <!-- Form Fields -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="lblTitle" Text="Add New Supplier / Vendor" Style="{DynamicResource HeaderPageTitle}" FontSize="18" DockPanel.Dock="Left"/>
                <Button Content="✕" Style="{DynamicResource BtnOutline}" Padding="8,2" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnCancel_Click"/>
            </DockPanel>

            <!-- Fields Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Supplier Name & Company -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Vendor / Supplier Name *" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtName"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Company / Trade Name" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtCompany"/>
                    </StackPanel>

                    <!-- Phone & Email -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Phone Number" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtPhone"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Email Address" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtEmail"/>
                    </StackPanel>

                    <!-- GSTIN & PAN -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="GSTIN" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtGSTIN"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="PAN" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtPAN"/>
                    </StackPanel>

                    <!-- Address & City -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Address" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtAddress"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="City" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtCity"/>
                    </StackPanel>

                    <!-- State & Pin Code -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="State" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtState" Text="Maharashtra"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Pin Code" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtPinCode"/>
                    </StackPanel>

                    <!-- Opening Balance & Bank Details -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Opening Balance Payable (₹)" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtOpeningBalance" Text="0.00"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Bank Account &amp; IFSC Details" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="txtBankDetails"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{DynamicResource BtnOutline}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="Save Supplier" Style="{DynamicResource BtnPrimary}" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
