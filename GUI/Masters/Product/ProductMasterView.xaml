<UserControl x:Class="AccuBooks_ERP.GUI.Masters.Product.ProductMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Search/Actions -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Product &amp; Item Catalog" Style="{DynamicResource HeaderPageTitle}"/>
                <TextBlock Text="Manage SKUs, barcodes, multi-tier pricing, taxes, and stock levels" Style="{DynamicResource HeaderPageSubtitle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="txtSearch" Width="220" Margin="0,0,10,0" VerticalAlignment="Center"
                         TextChanged="TxtSearch_TextChanged" Tag="Search by item name, SKU, barcode..."/>

                <Button x:Name="btnExport" Content="📊 Export Excel" Style="{DynamicResource BtnOutline}" Margin="0,0,10,0" Click="BtnExport_Click"/>
                <Button x:Name="btnAddProduct" Content="+ Add Product" Style="{DynamicResource BtnPrimary}" Click="BtnAddProduct_Click"/>
            </StackPanel>
        </Grid>

        <!-- Products DataGrid inside ModernCard -->
        <Border Grid.Row="1" Style="{DynamicResource ModernCard}">
            <DataGrid x:Name="dgProducts">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU / Code" Binding="{Binding ItemCode}" Width="110"/>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="1.8*"/>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="110"/>
                    <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPrice, StringFormat=₹ {0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="MRP" Binding="{Binding MRP, StringFormat=₹ {0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock}" Width="95"/>
                    <DataGridTemplateColumn Header="Actions" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Style="{DynamicResource BtnOutline}" Padding="8,3" Margin="0,0,6,0" Click="BtnEdit_Click"/>
                                    <Button Content="Del" Style="{DynamicResource BtnDanger}" Padding="8,3" Click="BtnDelete_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
