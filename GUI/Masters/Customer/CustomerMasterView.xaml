<UserControl x:Class="AccuBooks_ERP.GUI.Masters.Customer.CustomerMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Search/Actions -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Customer Directory" Style="{DynamicResource HeaderPageTitle}"/>
                <TextBlock Text="Manage client records, billing addresses, GSTIN and credit limits" Style="{DynamicResource HeaderPageSubtitle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <TextBox x:Name="txtSearch" Width="220" Margin="0,0,10,0" VerticalAlignment="Center"
                         TextChanged="TxtSearch_TextChanged" Tag="Search by name, phone, GSTIN..."/>

                <Button x:Name="btnExport" Content="📊 Export Excel" Style="{DynamicResource BtnOutline}" Margin="0,0,10,0" Click="BtnExport_Click"/>
                <Button x:Name="btnAddCustomer" Content="+ Add Customer" Style="{DynamicResource BtnPrimary}" Click="BtnAddCustomer_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main DataGrid inside ModernCard -->
        <Border Grid.Row="1" Style="{DynamicResource ModernCard}">
            <DataGrid x:Name="dgCustomers">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="1.5*"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.2*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="GSTIN" Binding="{Binding GSTIN}" Width="140"/>
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat=₹ {0:N2}}" Width="110"/>
                    <DataGridTemplateColumn Header="Actions" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Style="{DynamicResource BtnOutline}" Padding="8,3" Margin="0,0,6,0" Click="BtnEdit_Click"/>
                                    <Button Content="Del" Style="{DynamicResource BtnDanger}" Padding="8,3" Click="BtnDelete_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
