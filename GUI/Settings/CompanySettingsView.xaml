<UserControl x:Class="AccuBooks_ERP.GUI.Settings.CompanySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Company Info Card -->
                <RowDefinition Height="Auto"/> <!-- Security & Password Card -->
                <RowDefinition Height="Auto"/> <!-- Preferences & Theme Switcher -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="System Settings &amp; Company Profile" Style="{DynamicResource HeaderPageTitle}"/>
                <TextBlock Text="Configure organization metadata, tax registration, security credentials, and application themes" Style="{DynamicResource HeaderPageSubtitle}"/>
            </StackPanel>

            <!-- 1. Company Profile Card -->
            <Border Grid.Row="1" Style="{DynamicResource ModernCard}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="🏢 Enterprise Organization Profile" Style="{DynamicResource SectionHeader}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Company Name & Legal Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Display / Trade Name *" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtCompanyName"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Legal Registered Entity Name" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtLegalName"/>
                        </StackPanel>

                        <!-- GSTIN & PAN -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="GSTIN (Goods &amp; Services Tax ID)" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtGSTIN"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Permanent Account Number (PAN)" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtPAN"/>
                        </StackPanel>

                        <!-- Phone & Email -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Official Phone" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtPhone"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Official Email" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtEmail"/>
                        </StackPanel>

                        <!-- Address & City -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Registered Address" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtAddress"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="City" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtCity"/>
                        </StackPanel>

                        <!-- State & Currency Symbol -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="State &amp; State Code (e.g. Maharashtra - 27)" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtState"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Currency Symbol" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtCurrencySymbol" Text="₹"/>
                        </StackPanel>

                        <!-- Terms & Conditions -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="Default Invoice Terms &amp; Conditions" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtTerms" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="btnSaveCompany" Content="💾 Save Company Profile" Style="{DynamicResource BtnPrimary}" HorizontalAlignment="Right" Height="36" Padding="20,6" Click="BtnSaveCompany_Click"/>
                </StackPanel>
            </Border>

            <!-- 2. Security & Password Change Card -->
            <Border Grid.Row="2" Style="{DynamicResource ModernCard}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="🔐 User Security &amp; Password Update" Style="{DynamicResource SectionHeader}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Current Password" Style="{DynamicResource FieldLabel}"/>
                            <PasswordBox x:Name="txtCurrentPassword"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="New Password" Style="{DynamicResource FieldLabel}"/>
                            <PasswordBox x:Name="txtNewPassword"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="btnUpdatePassword" Content="Update Password" Style="{DynamicResource BtnOutline}" HorizontalAlignment="Right" Height="36" Padding="20,6" Click="BtnUpdatePassword_Click"/>
                </StackPanel>
            </Border>

            <!-- 3. Preferences & Theme Toggle Card -->
            <Border Grid.Row="3" Style="{DynamicResource ModernCard}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🎨 Application Color Theme" Style="{DynamicResource SectionHeader}"/>
                        <TextBlock Text="Toggle between modern Deep Slate/Navy Dark Mode and Clean Light Mode" Style="{DynamicResource BodySecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnDarkTheme" Content="🌙 Dark Theme" Style="{DynamicResource BtnOutline}" Margin="0,0,10,0" Click="BtnDarkTheme_Click"/>
                        <Button x:Name="btnLightTheme" Content="☀️ Light Theme" Style="{DynamicResource BtnOutline}" Click="BtnLightTheme_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
